# Copiar este archivo como .env (el .env no se sube a GitHub)

# Puerto de MongoDB en tu compu
MONGO_PORT=27017

# Nombre de la base de datos
MONGO_DB=gym

# Conexión desde tu compu (Compass, scripts, notebook)
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# Conexión desde otro contenedor del compose (la API, en la semana 3)
# MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
