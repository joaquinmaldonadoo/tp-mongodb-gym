# Copiar este archivo como .env (el .env no se sube a GitHub)

# Puertos en tu compu
MONGO_PORT=27017
API_PORT=8000

# Nombre de la base de datos
MONGO_DB=gym

# Conexión desde tu compu (Compass, scripts, notebook, tests)
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# La API dentro de Docker NO usa esta variable: el docker-compose.yml le pasa
# mongodb://mongo:27017/?replicaSet=rs0 (el nombre del servicio, no localhost)
